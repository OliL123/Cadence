<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_bg"
    android:layout_marginBottom="4dp"
    android:paddingLeft="8dp"
    android:paddingRight="2dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/item_stripe"
        android:layout_width="4dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_stripe"
        android:contentDescription="group" />

    <TextView
        android:id="@+id/item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#2A2418"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/item_star"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="5dp"
        android:src="@drawable/ic_star_outline"
        android:contentDescription="focus" />

    <ImageView
        android:id="@+id/item_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="4dp"
        android:src="@drawable/ic_check_todo"
        android:contentDescription="complete" />
</LinearLayout>
